<!--
  Cambios que hay que aplicar a android/app/src/main/AndroidManifest.xml
  después de ejecutar `npx cap add android`.

  No es un fichero de reemplazo: Capacitor genera su propio manifest con un
  FileProvider y rutas que cambian entre versiones. Sustituirlo entero rompería
  la app. Copia solo los bloques marcados en el sitio indicado.

  Sin el bloque 1 la app no aparece en la pantalla de inicio del televisor.
  Sin el bloque 2 Android la trata como app de móvil con pantalla táctil.
-->
<manifest>

    <!-- ===== BLOQUE 1: dentro del <intent-filter> del MainActivity ===== -->
    <!--
      Busca la actividad que ya tiene android.intent.category.LAUNCHER y añade
      LEANBACK_LAUNCHER junto a ella, en el mismo intent-filter.
      Dejar las dos hace que el icono salga tanto en TV como en móvil.

      Queda así:

        <activity android:name=".MainActivity" ...>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    -->
    <category android:name="android.intent.category.LEANBACK_LAUNCHER" />


    <!-- ===== BLOQUE 2: hijos directos de <manifest>, antes de <application> ===== -->
    <!--
      touchscreen required="false" es obligatorio para TV: un televisor no tiene
      pantalla táctil y sin esta línea el sistema descarta la app.
      leanback required="false" permite que siga instalándose en móviles.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- El televisor no tiene GPS ni cámara; declararlas opcionales evita rechazos. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Permite que el reproductor siga sonando y evita que el sistema baje el wifi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />


    <!-- ===== BLOQUE 3: atributos que hay que añadir a la etiqueta <application> ===== -->
    <!--
      android:banner es el rótulo 320x180 del lanzador de TV. En leanback no hay
      texto debajo del icono, así que el banner es lo único que ve el usuario.
      Copia tv_banner.png a android/app/src/main/res/drawable/tv_banner.png

      La etiqueta <application> queda con estos atributos añadidos:

        <application
            ...lo que ya había...
            android:banner="@drawable/tv_banner"
            android:isGame="false"
            android:hardwareAccelerated="true"
            android:networkSecurityConfig="@xml/network_security_config">
    -->

</manifest>
